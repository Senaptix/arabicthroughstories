# Supabase project API settings (safe browser-facing values; never add the service-role key here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Public origin used in authentication emails and redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: serve audio from a separate public origin
NEXT_PUBLIC_AUDIO_BASE_URL=

# Server-only Part C settings. Never prefix these with NEXT_PUBLIC_ and never
# commit their real values. ADMIN_EMAILS is a comma-separated allowlist.
ADMIN_EMAILS=owner@example.com
ACTIVATION_ISSUER_SECRET=replace-with-at-least-32-random-characters
# Provisioning also stores only this secret's SHA-256 digest in the private
# activation_code_settings database row; the plaintext never goes there.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=accounts@qasaskids.com
SMTP_PASSWORD=replace-with-the-mailbox-password

# Paddle (merchant of record) for direct digital sales. See PADDLE_CHECKOUT.md.
# Checkout stays hidden (404) unless PADDLE_CHECKOUT_ENABLED=true.
PADDLE_CHECKOUT_ENABLED=false
PADDLE_ENV=sandbox
# Browser-safe client-side token (Paddle > Developer tools > Authentication)
PADDLE_CLIENT_TOKEN=
# Server-only API key, used to look up a guest buyer's email
PADDLE_API_KEY=
# The notification destination's secret key
PADDLE_WEBHOOK_SECRET=
# One price per book, from the Paddle catalog. A book with no price is not for sale.
PADDLE_PRICE_IBRAHIM=
PADDLE_PRICE_YUSUF=
